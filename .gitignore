# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.mypy_cache/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Secrets: never committed. Copy .env.example to .env locally. ---
.env

# --- Local-only word list for scripts/preflight.py, if you use one ---
.preflight-words

# --- Data and run outputs: regenerated by the code, never committed ---
# The phantom set is rebuilt by `stableseg phantom`; real data is downloaded
# by the ingestion phase. Keeping them out keeps the repository small and
# keeps every result traceable to the code that produced it.
#
# Note the trailing /* rather than a bare folder name. Git does not look
# inside an excluded DIRECTORY, so `data/` followed by `!data/.gitkeep` would
# silently ignore the exception and the placeholder would never be tracked.
# Excluding the CONTENTS instead lets Git descend far enough to honour it.
data/*
runs/*
!data/.gitkeep
!runs/.gitkeep

# --- R working files ---
# .Rproj.user holds RStudio's per-user pane layout and scratch state; the
# others are session leftovers. stableseg.Rproj ITSELF is committed - it is
# the shared project settings, and it is what makes RStudio open at the right
# working directory. renv/library is a local package cache, restored from
# renv.lock, so it is excluded the same way .venv is.
.Rproj.user/
.Rhistory
.RData
.Ruserdata
renv/library/
renv/local/
renv/staging/

# --- Rendered documents (Quarto) ---
_site/
*.quarto_ipynb
.quarto/
