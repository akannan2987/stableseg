# --- Secrets: never committed. Copy .env.example to .env locally. ---
.env

# --- Data and run outputs: regenerated by the code, never committed ---
# The phantom set is rebuilt by `stableseg phantom`; real data is downloaded
# by the ingestion phase. Keeping them out keeps the repository small and
# keeps every result traceable to the code that produced it.
data/
runs/
!data/.gitkeep
!runs/.gitkeep

# --- Rendered documents (Quarto) ---
_site/
*.quarto_ipynb
.quarto/
